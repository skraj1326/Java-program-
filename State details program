class TN {
    static String sta = "Tamil Nadu";
    String pm;
    String cm;
    String dist_name;
    int pop;

    public void state_det(String a, String b, String c, int d) {
        pm = a;
        cm = b;
        dist_name = c;
        pop = d;
    }

    public void display() {
        System.out.println("1. PM: " + pm);
        System.out.println("2. CM: " + cm);
        System.out.println("3. State Name: " + sta);
        System.out.println("4. District Name: " + dist_name);
        System.out.println("5. Population: " + pop);
        System.out.println();
    }
}

class AP {
    static String sta = "Andhra Pradesh";
    String pm;
    String cm;
    String dist_name;
    int pop;

    public void state_det(String a, String b, String c, int d) {
        pm = a;
        cm = b;
        dist_name = c;
        pop = d;
    }

    public void display() {
        System.out.println("1. PM: " + pm);
        System.out.println("2. CM: " + cm);
        System.out.println("3. State Name: " + sta);
        System.out.println("4. District Name: " + dist_name);
