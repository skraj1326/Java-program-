        System.out.println();
    }
}

public class Main {
    public static void main(String[] args) {

        TN a = new TN();
        TN b = new TN();

        AP a1 = new AP();
        AP b1 = new AP();

        a.state_det("Narendra Modi", "Joseph Vijay", "Madurai", 70000);
        b.state_det("Rahul", "M K Stalin", "TVM", 80000);

        a1.state_det("Rahul", "M K Stalin", "Karnool", 80000);
        b1.state_det("Narendra Modi", "Joseph Vijay", "Chitoor", 70000);

        a.display();
        b.display();
        a1.display();
        b1.display();
    }
}
