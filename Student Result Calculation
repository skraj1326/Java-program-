import java.util.Scanner;

class student {
    String name;
    int p;
    int q;
    int r;

    student(String name1, int a, int b, int c) {
        name = name1;
        p = a;
        q = b;
        r = c;
    }

    public void display() {
        double percentage = (p + q + r) / 3.0;

        System.out.println("Student Name: " + name);
        System.out.println("Mark 1: " + p);
        System.out.println("Mark 2: " + q);
        System.out.println("Mark 3: " + r);
        System.out.println("Result Percentage is: " + percentage + "%");
    }
}

public class Main {
    public static void main(String[] args) {

        int mark1, mark2, mark3;
        String name;

        Scanner a = new Scanner(System.in);

        System.out.println("Enter the Number of Students:");
        int n = a.nextInt();
        a.nextLine(); // consume leftover newline

        student[] s = new student[n];

        for (int i = 0; i < n; i++) {

            System.out.println("\nEnter the Student Name " + (i + 1) + ":");
            name = a.nextLine();

            System.out.println("Enter the Mark of Subject 1:");
            mark1 = a.nextInt();

            System.out.println("Enter the Mark of Subject 2:");
            mark2 = a.nextInt();

            System.out.println("Enter the Mark of Subject 3:");
            mark3 = a.nextInt();

            a.nextLine(); // consume leftover newline

            s[i] = new student(name, mark1, mark2, mark3);
        }

        System.out.println("\nLet's see the Student Results:");

        for (int i = 0; i < n; i++) {
            System.out.println("\nStudent " + (i + 1));
            s[i].display();
        }

        a.close();
    }
}
